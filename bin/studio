#!/usr/bin/env bash
# The studio kit from anywhere: Claude Code puts a plugin's bin/ on PATH, so agents and commands call `studio ...`.
#   studio start <project> [--check] [--no-setup]   start or resume a session (setup, kit check, resume)
#   studio gate <gate.py arguments>                  --ready, --decide, --status, --checklist, --reopen, --retro ...
#   studio tool <name> [arguments]                   any engine tool: pass.py, refs.py, uniq.py, shot.js, greek.py ...
#   studio paths                                     where the engine, studio and current project are
# KIT_HOME (the studio's workspace, holding studio/ and projects/) defaults to Claude Code's project folder, else the
# working directory. KIT_PROJECT picks a project for this call (several projects can run side by side); else .current.
# Tools run from the project folder, so the project-relative paths in the stage prompts work as written.
ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
E="$ROOT/engine"
export KIT_HOME="${KIT_HOME:-${CLAUDE_PROJECT_DIR:-$PWD}}"
cmd="$1"; shift 2>/dev/null
proj() { echo "${KIT_PROJECT:-$(cat "$KIT_HOME/.current" 2>/dev/null)}"; }
inproj() { local p; p="$(proj)"; if [ -n "$p" ] && [ -d "$KIT_HOME/projects/$p" ]; then cd "$KIT_HOME/projects/$p"; else cd "$KIT_HOME"; fi; }
case "$cmd" in
  start) exec bash "$E/tools/start.sh" "$@" ;;
  gate)  inproj; exec python3 "$E/tools/gate.py" "$@" ;;
  tool)
    t="$1"; shift
    [ -f "$E/tools/$t" ] || { echo "studio: no tool $t (see $E/tools)"; exit 1; }
    inproj
    case "$t" in
      *.py) exec python3 "$E/tools/$t" "$@" ;;
      *.js) NODE_PATH="$(cat "$KIT_HOME/.node" 2>/dev/null)" exec node "$E/tools/$t" "$@" ;;
      *.sh) exec bash "$E/tools/$t" "$@" ;;
    esac ;;
  paths) echo "engine  $E"; echo "studio  $KIT_HOME/studio"; p="$(proj)"; echo "project ${p:+$KIT_HOME/projects/$p}" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
